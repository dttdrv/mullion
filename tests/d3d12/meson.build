d3d12_test_deps = [ cpp.find_library('d3d12'), cpp.find_library('d3dcompiler_47'), cpp.find_library('dxgi'), cpp.find_library('psapi') ]
# 'window' tests present to a real window: through a Metal view where winemac.drv exports it, through GDI elsewhere
# a test runs through both shader front ends, or the one its third field names when the other cannot express it
# the sources a test has beside its own
d3d12_test_sources = { 'd3d12_tessellator': files('../reference/reference.cpp'),
                       'd3d12_library': files('../../src/util/sha1/sha1_util.cpp', '../../src/util/sha1/sha1.c') }
adapters = executable('d3d12_adapters', 'd3d12_adapters.cpp', dependencies: d3d12_test_deps)
foreach front_end : ['dxil', 'dxbc']
  test('d3d12_adapters_' + front_end, adapters, args: [front_end], timeout: 600)
endforeach
# workloads tests/held.py profiles
executable('d3d12_held', 'd3d12_held.cpp', dependencies: d3d12_test_deps)
# runs tests/flight.py reads the flight recorder's dumps of
executable('d3d12_flight', 'd3d12_flight.cpp', dependencies: d3d12_test_deps + [cpp.find_library('d3d11')])
exe = executable('d3d12_d3d11on12', ['d3d12_d3d11on12.cpp'], dependencies: d3d12_test_deps + [cpp.find_library('d3d11')])
test('d3d12_d3d11on12', exe, timeout: 600)
exe = executable('d3d12_trace_log', ['d3d12_trace_log.cpp'], dependencies: d3d12_test_deps + [cpp.find_library('d3d11')])
test('d3d12_trace_log', exe, timeout: 600)
exe = executable('d3d12_xrbias', ['d3d12_xrbias.cpp'], dependencies: d3d12_test_deps)
foreach front_end : ['dxil', 'dxbc']
  test('d3d12_xrbias_' + front_end, exe, args: [ front_end ], suite: 'window', timeout: 600)
endforeach
foreach t : [['d3d12_sdk_configuration', []], ['d3d12_metal4_passes', []], ['d3d12_atomic64_forms', [], ['dxil']], ['d3d12_blending', []], ['d3d12_block_values', []], ['d3d12_buffer_description', []], ['d3d12_placement', []], ['d3d12_buffer_regions', []], ['d3d12_buffer_stores', [], ['dxil']], ['d3d12_depth_copy', []], ['d3d12_depth_formats', []], ['d3d12_depth_stencil', []], ['d3d12_descriptor_ranges', []], ['d3d12_device_removal', []], ['d3d12_dxbc_arithmetic', [], ['dxbc']], ['d3d12_dxbc_calls', [], ['dxbc']], ['d3d12_footprints', []], ['d3d12_format_blend', []], ['d3d12_format_cpu', []], ['d3d12_format_logic', []], ['d3d12_format_msaa', []], ['d3d12_format_values', []], ['d3d12_format_vertices', []], ['d3d12_gather', []], ['d3d12_ia_patches', []], ['d3d12_indirect_roots', []], ['d3d12_indirect_state', []], ['d3d12_isnormal', [], ['dxil']], ['d3d12_logic', []], ['d3d12_objects', []], ['d3d12_om_order', []], ['d3d12_packed', [], ['dxil']], ['d3d12_raster', []], ['d3d12_raster_bias', []], ['d3d12_raster_samples', []], ['d3d12_residency_api', []], ['d3d12_resource_map', []], ['d3d12_root_constants', []], ['d3d12_root_limits', []], ['d3d12_root_ranges', []], ['d3d12_sample_mask', []], ['d3d12_sample_positions', []], ['d3d12_shader_groups', []], ['d3d12_streamout_indirect', []], ['d3d12_swapchain_rendering', ['window']], ['d3d12_vertex_formats', []], ['d3d12_vertex_buffer_slots', []], ['d3d12_wave_helpers', [], ['dxil']], ['d3d12_wave_size', [], ['dxil']], ['d3d12_wave_types', [], ['dxil']], ['d3d12_sm67', [], ['dxil']], ['d3d12_conservative', []], ['d3d12_pipeline_formats', []], ['d3d12_pipeline_acceptance', []], ['d3d12_query_validation', []], ['d3d12_geometry_oversize', []], ['d3d12_startup', []], ['d3d12_sampler_slots', []], ['d3d12_sampler_anisotropy', []], ['d3d12_anisotropy_bias', []], ['d3d12_groupsync', []], ['d3d12_custom_readback', []], ['d3d12_frac', []], ['d3d12_atomic64_parts', [], ['dxil']], ['d3d12_view_types', []], ['d3d12_indirect_many', []], ['d3d12_commandlist8', []], ['d3d12_queued_present', []], ['d3d12_statistics_heap', []], ['d3d12_shader_flags', []], ['d3d12_atomic64_fallback', [], ['dxil']], ['d3d12_late', []], ['d3d12_minmax', []], ['d3d12_wave_float', [], ['dxil']], ['d3d12_fmad', []], ['d3d12_rgb32', []], ['d3d12_clear_rectangles', []], ['d3d12_clear_values', []], ['d3d12_clear_uav_bits', [], ['dxil']], ['d3d12_clear_folds', []], ['d3d12_copy_runs', [], ['dxil']], ['d3d12_double_ops', []], ['d3d12_view_threads', []], ['d3d12_alias_submissions', []], ['d3d12_view_instance_mask', []], ['d3d12_uav_casts', []], ['d3d12_attachments', []], ['d3d12_copy_formats', []], ['d3d12_destruction', []], ['d3d12_heap_import', []], ['d3d12_library', []], ['d3d12_ray_exports', [], ['dxil']], ['d3d12_root_versions', []], ['d3d12_sparse_remap', []], ['d3d12_psout', []], ['d3d12_shared_fence', []], ['d3d12_fence_release', []], ['d3d12_resource_interfaces', []], ['d3d12_planar', []], ['d3d12_feature_queries', []], ['d3d12_embedded', []], ['d3d12_stream_defaults', []], ['d3d12_cbuffer_layout', []], ['d3d12_rov_root', []], ['d3d12_integer_blending', []], ['d3d12_state_validation', [], ['dxil']], ['d3d12_swapchain_refs', []], ['d3d12_swapchain_creation', []], ['d3d12_sample_residency', []], ['d3d12_denorm', []], ['d3d12_recording_failure', []], ['d3d12_validation', []], ['d3d12_swapchain_fullscreen', ['window']], ['d3d12_buffer_loads', []], ['d3d12_profile', ['timing']], ['d3d12_shadercache', []], ['d3d12_pipeline_times', []], ['d3d12_sampling', []], ['d3d12_compute', []], ['d3d12_dispatch_order', []], ['d3d12_resources', []], ['d3d12_math', []], ['d3d12_msaa', []], ['d3d12_features', []], ['d3d12_obligations', []], ['d3d12_sizes', []], ['d3d12_queues', []], ['d3d12_submission', []], ['d3d12_persistent', []], ['d3d12_residency', []], ['d3d12_together', []], ['d3d12_fetch', []], ['d3d12_parts', []], ['d3d12_corpus', []], ['d3d12_operations', []], ['d3d12_precache', []], ['d3d12_garbled', []], ['d3d12_mipchain', []], ['d3d12_la