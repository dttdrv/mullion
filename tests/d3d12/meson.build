d3d12_test_deps = [ cpp.find_library('d3d12'), cpp.find_library('d3dcompiler_47'), cpp.find_library('dxgi'), cpp.find_library('psapi') ]
# 'window' tests present to a real window: through a Metal view where winemac.drv exports it, through GDI elsewhere
# the sources a test has beside its own
d3d12_test_sources = { 'd3d12_tessellator': files('../reference/reference.cpp') }
foreach t : [ ['d3d12_profile', []], ['d3d12_shadercache', []], ['d3d12_pipeline_times', []], ['d3d12_sampling', []], ['d3d12_compute', []], ['d3d12_resources', []], ['d3d12_math', []], ['d3d12_msaa', []], ['d3d12_features', []], ['d3d12_obligations', []], ['d3d12_sizes', []], ['d3d12_queues', []], ['d3d12_submission', []], ['d3d12_persistent', []], ['d3d12_residency', []], ['d3d12_together', []], ['d3d12_fetch', []], ['d3d12_parts', []], ['d3d12_corpus', []], ['d3d12_operations', []], ['d3d12_precache', []], ['d3d12_garbled', []], ['d3d12_mipchain', []], ['d3d12_layers', []], ['d3d12_groupshared', []], ['d3d12_groupleader', []], ['d3d12_wavegroups', []], ['d3d12_later', []], ['d3d12_indirect', []], ['d3d12_indirect_draw', []], ['d3d12_indirect_written', []], ['d3d12_indirect_frames', []], ['d3d12_steady', []], ['d3d12_released', []], ['d3d12_bounds', []], ['d3d12_instances', []], ['d3d12_atomic64_pixels', []], ['d3d12_reads', []], ['d3d12_indirect_vertices', []], ['d3d12_barrier', []], ['d3d12_fences', []], ['d3d12_wave', []], ['d3d12_heap', []], ['d3d12_sm66', []], ['d3d12_quads', []], ['d3d12_half', []], ['d3d12_levels', []], ['d3d12_viewports', []], ['d3d12_queries', []], ['d3d12_occlusion_far', []], ['d3d12_occlusion_many', []], ['d3d12_occlusion_passes', []], ['d3d12_occlusion_replay', []], ['d3d12_frames', []], ['d3d12_indirect_start', []], ['d3d12_indirect_stride', []], ['d3d12_streamout_arguments', []], ['d3d12_recorded', []], ['d3d12_predication', []], ['d3d12_cached', []], ['d3d12_resolve', []], ['d3d12_tiled', []], ['d3d12_bundle', []], ['d3d12_recording', []], ['d3d12_loader', []], ['d3d12_copytiles', []], ['d3d12_depthbounds', []], ['d3d12_tilemap', []], ['d3d12_border', []], ['d3d12_tessellation', []], ['d3d12_patches', []], ['d3d12_tessellator', []], ['d3d12_atomic64', []], ['d3d12_visibility', []], ['d3d12_geometry', []], ['d3d12_streamout', []], ['d3d12_streamout_writes', []], ['d3d12_assembly', []], ['d3d12_primitiveid', []], ['d3d12_draws', []], ['d3d12_copies', []], ['d3d12_wide', []], ['d3d12_mesh', []], ['d3d12_meshout', []], ['d3d12_varyings', []], ['d3d12_feedback', []], ['d3d12_rayquery', []], ['d3d12_raytracing', []], ['d3d12_present', ['window']], ['d3d12_video', ['window']], ['d3d12_presented', ['window']], ['d3d12_swapchain', ['window']], ['d3d12_child', ['window']] ]
  exe = executable(t[0], [t[0] + '.cpp'] + d3d12_test_sources.get(t[0], []), dependencies: d3d12_test_deps)
  foreach front_end : ['dxil', 'dxbc']
    test(t[0] + '_' + front_end, exe, args: [ front_end ], suite: t[1], timeout: 600)
  endforeach
endforeach
