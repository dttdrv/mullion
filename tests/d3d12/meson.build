3d12_rayquery', [], ['dxil']], ['d3d12_raytracing', [], ['dxil']], ['d3d12_present', ['window']], ['d3d12_video', ['window']], ['d3d12_presented', ['window']], ['d3d12_swapchain', ['window']], ['d3d12_child', ['window']], ['d3d12_ps_writes', []]]
  exe = executable(t[0], [t[0] + '.cpp'] + d3d12_test_sources.get(t[0], []), dependencies: d3d12_test_deps +
                   (t[0] in ['d3d12_swapchain_fullscreen', 'd3d12_shared_fence'] ? [cpp.find_library('d3d11')] : []))
  foreach front_end : t.get(2, ['dxil', 'dxbc'])
    test(t[0] + '_' + front_end, exe, args: [ front_end ], suite: t[1], is_parallel: 'timing' not in t[1],
         timeout: 600)
    if t[0] == 'd3d12_persistent'
      test(t[0] + '_allocate_' + front_end, exe, args: [front_end, 'ALLOCATE=1'], timeout: 600)
    endif
    if t[0] == 'd3d12_streamout_arguments'
      test(t[0] + '_zero_' + front_end, exe, args: [front_end, 'zero'], timeout: 600)
      test(t[0] + '_predicated_' + front_end, exe, args: [front_end, 'predicated'], timeout: 600)
      benchmark(t[0] + '_' + front_end, exe, args: [front_end, 'bench'], timeout: 600)
    endif
    if t[0] == 'd3d12_pass_overlap'
      benchmark(t[0] + '_' + front_end, exe, args: [front_end, 'bench'], timeout: 600)
      benchmark(t[0] + '_mixed_' + front_end, exe, args: [front_end, 'bench-mixed'], timeout: 600)
    endif
    if t[0] == 'd3d12_indirect'
      test(t[0] + '_zero_' + front_end, exe, args: [front_end, 'zero'], timeout: 600)
    endif
  endforeach
endforeach
