// a mesh is a handle: what it is given goes to the recorder it points to
struct recorder {
  std::vector<uint> indices;
  std::vector<bool> culled;
  uint primitives = 0;
};
template <typename V, typename P, int, int, topology>
struct mesh {
  recorder *to;
  void set_index(uint at, uint vertex) const {
    if (to->indices.size() <= at)
      to->indices.resize(at + 1, ~0u);
    to->indices[at] = vertex;
  }
  void set_primitive(uint at, P p) const {
    if (to->culled.size() <= at)
      to->culled.resize(at + 1);
    to->culled[at] = p.culled;
  }
  void set_primitive_count(uint count) const { to->primitives = count; }
};
} // namespace metal
