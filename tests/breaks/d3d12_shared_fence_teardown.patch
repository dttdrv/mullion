# the listener is freed when its thread ends, while Metal still holds notifications for it, as it was before
diff --git a/src/winemetal/unix/winemetal_unix.c b/src/winemetal/unix/winemetal_unix.c
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -3545,7 +3545,7 @@ _SharedEventListener_start(void *obj) {
     pthread_mutex_unlock(&q->mutex);
     CFRunLoopRemoveSource(runloop, source, kCFRunLoopCommonModes);
     CFRelease(source);
-    shared_event_listener_release(q);
+    free(q);
   }
   return STATUS_SUCCESS;
 }
