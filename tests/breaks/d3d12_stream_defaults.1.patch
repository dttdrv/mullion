     }
@@ -1222,2 +1221,4 @@
         desc_graphics.StreamOutput = subobject->data;
+        if (!(defined_type & (1 << D3D12_PIPELINE_STATE_SUBOBJECT_TYPE_PRIMITIVE_TOPOLOGY)))
+          desc_graphics.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
         break;
