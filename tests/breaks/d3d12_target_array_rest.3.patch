diff --git a/src/d3d12/d3d12_texture.cpp b/src/d3d12/d3d12_texture.cpp
index aac062a..452a3ad 100644
--- a/src/d3d12/d3d12_texture.cpp
+++ b/src/d3d12/d3d12_texture.cpp
@@ -956,7 +956,7 @@ public:
       view_descriptor.miplevelCount = 1;
       view_descriptor.firstArraySlice = ViewDesc.Texture2DMSArray.FirstArraySlice;
       view_descriptor.arraySize = ViewDesc.Texture2DMSArray.ArraySize == ~0u
