# Metal 3: the wait for a command buffer's event ends once Metal has scheduled the buffer, before its work is done
# family native-metal3
--- a/src/winemetal/unix/winemetal_unix.c
+++ b/src/winemetal/unix/winemetal_unix.c
@@ -205,7 +205,8 @@
   // the buffer signals the event after its work, which a failed buffer may never reach: its status ends the wait then.
   // what the work wrote is visible to the CPU at the signal, as at a GPU wait for it (Metal, Resource synchronization:
   // events), before Metal calls the buffer completed
-  while (![(id<MTLSharedEvent>)params->arg0 waitUntilSignaledValue:params->arg1 timeoutMS:100])
+  while ([buffer status] < MTLCommandBufferStatusScheduled &&
+         ![(id<MTLSharedEvent>)params->arg0 waitUntilSignaledValue:params->arg1 timeoutMS:100])
     if ([buffer status] >= MTLCommandBufferStatusCompleted)
       break;
   return STATUS_SUCCESS;
