@@ -1690,9 +1690,6 @@
   bool
   Native() {
     // of the pipeline the draw takes, whose tessellator's kernel is made with it (DeferredPipeline)
-    TakeFuller();
-    if (!pso_graphics_)
-      return false;
     pso_graphics_->WaitPipeline();
     return pso_graphics_->hull && active_statistics_.empty();
   }
